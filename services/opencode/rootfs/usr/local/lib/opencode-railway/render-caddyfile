#!/bin/sh
# Prints the Caddyfile for the HTTP front on $PORT.
#
# Inputs (environment):
#   OC_HTTP_PORT      listen port (Railway's PORT); Caddy binds all
#                     interfaces, IPv4 and IPv6
#   OC_INTERNAL_PORT  OpenCode's loopback port
#
# Caddy runtime environment (not read here): OPENCODE_HEALTH_AUTH, the
# "Basic ..." header Caddy adds to the /healthz probe only.
#
# Routing:
#   /healthz  Railway's anonymous healthcheck. Replayed as an authenticated
#             GET to OpenCode's /global/health (query string dropped); answers
#             "ok" (200) when OpenCode is up and accepts the credential,
#             otherwise 503. Never returns OpenCode's own payload.
#   anything  proxied unchanged to OpenCode, which enforces its own basic auth
#             (OPENCODE_SERVER_PASSWORD). Host is passed through, as OpenCode's
#             terminal (PTY) endpoints compare Origin and Host.
set -eu

port="${OC_HTTP_PORT:?OC_HTTP_PORT is required}"
upstream_port="${OC_INTERNAL_PORT:?OC_INTERNAL_PORT is required}"

fail() { echo "render-caddyfile: $*" >&2; exit 1; }

case "${port}" in ''|*[!0-9]*) fail "invalid port '${port}'" ;; esac
case "${upstream_port}" in ''|*[!0-9]*) fail "invalid OpenCode port '${upstream_port}'" ;; esac
[ "${port}" != "${upstream_port}" ] || fail "PORT and the OpenCode port must differ"

cat <<EOF
# Generated by opencode-entrypoint at every container start. Do not edit.
{
	admin off
	auto_https off
	persist_config off
	log {
		output stderr
		format console
		level WARN
	}
}

:${port} {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
		-Server
	}

	handle /healthz {
		header Cache-Control no-store
		rewrite * /global/health?
		reverse_proxy 127.0.0.1:${upstream_port} {
			header_up Authorization {env.OPENCODE_HEALTH_AUTH}
			@healthy status 2xx
			handle_response @healthy {
				respond "ok" 200
			}
			handle_response {
				respond "unhealthy" 503
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:${upstream_port} {
			# Server-sent events (/global/event, /event) must not be buffered.
			flush_interval -1
		}
	}
}
EOF
